# Godot 项目文本文件统一使用 LF 行尾，避免跨平台差异
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.json      text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# 二进制文件不参与行尾转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ogg       binary
*.mp3       binary
*.wav       binary
*.ttf       binary
*.fontdata  binary
